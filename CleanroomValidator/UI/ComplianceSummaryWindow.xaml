<Window x:Class="CleanroomValidator.UI.ComplianceSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cleanroom HVAC Designer"
        Height="760" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="StatusCompliant" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="StatusPartial" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F57C00"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="StatusFail" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C62828"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="LevelGroupStyle" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <Expander IsExpanded="True" Background="#E8E8E8" Margin="0,3,0,0">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Margin="5,2"/>
                                    <TextBlock Text="{Binding ItemCount, StringFormat=' ({0} spaces)'}"
                                               Foreground="#666" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <ItemsPresenter/>
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Cleanroom HVAC Designer" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>

            <!-- Linked models — multi-select checklist -->
            <CheckBox x:Name="UseLinkedModelCheckbox"
                      Content="Linked Models:"
                      VerticalAlignment="Center"
                      Margin="30,0,8,0"
                      Checked="UseLinkedModelCheckbox_Changed"
                      Unchecked="UseLinkedModelCheckbox_Changed"/>

            <!-- Checkable Dropdown for linked models -->
            <Grid Width="200" VerticalAlignment="Center" Margin="0,0,12,0">
                <ToggleButton x:Name="LinkedModelToggle"
                              IsEnabled="False"
                              Content="Select Linked Models ▼"
                              Height="26"
                              HorizontalContentAlignment="Left"
                              Padding="5,0"/>
                <Popup IsOpen="{Binding IsChecked, ElementName=LinkedModelToggle}"
                       StaysOpen="False"
                       PlacementTarget="{Binding ElementName=LinkedModelToggle}"
                       Placement="Bottom"
                       AllowsTransparency="True">
                    <Border Background="White" BorderBrush="#CCC" BorderThickness="1" MinWidth="200" MaxHeight="250">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LinkedModelItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Title}"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Checked="LinkedModelItem_CheckChanged"
                                                  Unchecked="LinkedModelItem_CheckChanged"
                                                  Margin="5,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>

            <!-- Leakage class selector -->
            <TextBlock Text="Door Leakage:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
            <ComboBox x:Name="LeakageClassComboBox"
                      Width="170" VerticalAlignment="Center" Margin="0,0,0,0"
                      SelectionChanged="LeakageClass_Changed">
                <ComboBoxItem Content="Typical cleanroom (0.008 m²)" IsSelected="True"/>
                <ComboBoxItem Content="Very tight door (0.005 m²)"/>
                <ComboBoxItem Content="Ordinary door (0.012 m²)"/>
            </ComboBox>

            <!-- Unit toggle -->
            <Border Background="#1A1A2E" CornerRadius="4" Margin="30,0,0,0" Padding="4,2">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RadioSI" Content="SI" Foreground="White" FontWeight="Bold"
                                 GroupName="Units" IsChecked="True" Margin="4,0"
                                 Checked="UnitToggle_Changed"/>
                    <RadioButton x:Name="RadioImperial" Content="Imperial" Foreground="White"
                                 GroupName="Units" Margin="4,0"
                                 Checked="UnitToggle_Changed"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="0,0,0,10" BorderThickness="0" Background="Transparent"
                    SelectionChanged="MainTabControl_SelectionChanged">
            <TabItem Header="Compliance Table">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
    <!-- Summary Stats + Search -->
            <Border Grid.Row="0" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Summary: " FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CompliantCount" Style="{StaticResource StatusCompliant}" VerticalAlignment="Center" Margin="10,0"/>
                        <TextBlock Text=" | " VerticalAlignment="Center"/>
                        <TextBlock x:Name="PartialCount" Style="{StaticResource StatusPartial}" VerticalAlignment="Center" Margin="10,0"/>
                        <TextBlock Text=" | " VerticalAlignment="Center"/>
                        <TextBlock x:Name="FailCount" Style="{StaticResource StatusFail}" VerticalAlignment="Center" Margin="10,0"/>
                        <Separator Width="1" Height="20" Background="#CCC" Margin="15,0"/>
                        <CheckBox x:Name="HideUnclassifiedCheckbox"
                                  Content="Cleanrooms only"
                                  VerticalAlignment="Center" Margin="10,0"
                                  ToolTip="When checked, hides unclassified spaces and shows only spaces with a cleanliness class assigned."
                                  Checked="HideUnclassified_Changed"
                                  Unchecked="HideUnclassified_Changed"/>
                        <Separator Width="1" Height="20" Background="#CCC" Margin="15,0"/>
                        <TextBlock Text="💡 Edit ACH, Supply, Return, Exhaust or Pressure directly. Changes apply to selected rows."
                                   FontSize="11" Foreground="#555" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Search box -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔍 " VerticalAlignment="Center" FontSize="14"/>
                        <TextBox x:Name="SearchBox"
                                 Width="180" Height="26"
                                 VerticalContentAlignment="Center"
                                 Padding="6,0"
                                 BorderBrush="#CCC" BorderThickness="1"
                                 ToolTip="Filter spaces by name or number"
                                 TextChanged="SearchBox_TextChanged"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Data Grid -->
            <DataGrid x:Name="ResultsGrid"
                  Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      SelectionChanged="ResultsGrid_SelectionChanged"
                      PreviewMouseLeftButtonDown="ResultsGrid_PreviewMouseLeftButtonDown"
                      CellEditEnding="ResultsGrid_CellEditEnding"
                      Background="White"
                      BorderBrush="#DDD"
                      BorderThickness="1"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEE"
                      RowHeight="30"
                      ColumnHeaderHeight="35">
                <DataGrid.Resources>
                    <!-- Override selection colours so text stays visible and cell backgrounds show -->
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"         Color="#C5CAE9"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"     Color="Black"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#E8EAF6"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>
                </DataGrid.Resources>
                <DataGrid.GroupStyle>
                    <GroupStyle ContainerStyle="{StaticResource LevelGroupStyle}">
                        <GroupStyle.Panel>
                            <ItemsPanelTemplate>
                                <DataGridRowsPresenter/>
                            </ItemsPanelTemplate>
                        </GroupStyle.Panel>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <!-- Select checkbox -->
                    <DataGridTemplateColumn Width="35" CanUserSort="False" CanUserReorder="False">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="SelectAllCheckbox" ToolTip="Select all"
                                          Checked="SelectAll_Checked" Unchecked="SelectAll_Unchecked"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Read-only identity columns -->
                    <DataGridTextColumn Header="No."     Binding="{Binding RoomNumber}"       Width="40"  IsReadOnly="True" SortMemberPath="RoomNumberSort">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Padding" Value="5,0"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Space"   Binding="{Binding RoomName}"         Width="*"   IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Padding" Value="5,0"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Class"   Binding="{Binding CleanlinessClass}" Width="65"  IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="ColVolume" Header="Volume (m³)" Binding="{Binding VolumeDisplay, StringFormat=N1}" Width="85" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Editable flow columns — yellow tint signals writeable -->
                    <DataGridTextColumn x:Name="ColCfm"    Header="Supply (m³/h)"
                                        Binding="{Binding SupplyEditDisplay, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="95">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Background" Value="#FFFDE7"/></Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox"><Setter Property="Background" Value="#FFFDE7"/></Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="ColReturn"  Header="Return (m³/h)"
                                        Binding="{Binding ReturnEditDisplay, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="95">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Background" Value="#FFFDE7"/></Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox"><Setter Property="Background" Value="#FFFDE7"/></Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="ColExhaust" Header="Exhaust (m³/h)"
                                        Binding="{Binding ExhaustEditDisplay, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Background" Value="#FFFDE7"/></Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox"><Setter Property="Background" Value="#FFFDE7"/></Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <!-- ACH — shows actual value, editable as target -->
                    <DataGridTextColumn x:Name="ColAch" Header="ACH" Width="75"
                                        Binding="{Binding AchTargetEdit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="Foreground" Value="#0D47A1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AchStatus}" Value="Under">
                                        <Setter Property="Background" Value="#FFCDD2"/>
                                        <Setter Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AchStatus}" Value="Over">
                                        <Setter Property="Background" Value="#FFCDD2"/>
                                        <Setter Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AchStatus}" Value="Partial">
                                        <Setter Property="Background" Value="#FFF9C4"/>
                                        <Setter Property="Foreground" Value="#F57C00"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="ACH Req" Binding="{Binding RequiredAchRange}" Width="75" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding RecoveryTimeMinutes, StringFormat=N1}" Width="105" IsReadOnly="True"
                                        SortMemberPath="RecoveryTimeMinutes">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="Recovery (min)"
                                       ToolTip="Time required to return to the target cleanliness level after a contamination event (100:1 dilution)"/>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Editable Pressure column -->
                    <DataGridTextColumn x:Name="ColPressure" Header="Pressure (Pa)" SortMemberPath="PressurePa"
                                        Binding="{Binding PressureEditPa, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox"><Setter Property="TextAlignment" Value="Center"/><Setter Property="Background" Value="#FFF9C4"/></Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <!-- Status -->
                    <DataGridTemplateColumn Header="Status" Width="55" IsReadOnly="True" SortMemberPath="OverallStatus">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusIcon}" HorizontalAlignment="Center" FontSize="16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OverallStatus}" Value="Compliant">
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OverallStatus}" Value="PartialCompliance">
                                                    <Setter Property="Foreground" Value="#F57C00"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OverallStatus}" Value="NonCompliant">
                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Detail Panel -->
            <Border Grid.Row="2" Background="White" CornerRadius="5" Padding="15" Margin="0,15,0,0">
                <StackPanel>
                    <TextBlock Text="Check Details" Style="{StaticResource HeaderStyle}"/>
                    <DataGrid x:Name="DetailsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MaxHeight="150"
                              Background="White"
                              BorderThickness="0"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              RowHeight="25">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Check"    Binding="{Binding CheckName}" Width="*"/>
                            <DataGridTextColumn Header="Required" Binding="{Binding Required}"  Width="130"/>
                            <DataGridTextColumn Header="Actual"   Binding="{Binding Actual}"    Width="130"/>
                            <DataGridTemplateColumn Header="Result" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="—"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Compliant">
                                                            <Setter Property="Text"       Value="✓"/>
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="PartialCompliance">
                                                            <Setter Property="Text"       Value="⚠"/>
                                                            <Setter Property="Foreground" Value="#F57C00"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="NonCompliant">
                                                            <Setter Property="Text"       Value="✗"/>
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        
                </Grid>
            </TabItem>
            <TabItem Header="Pressure Network">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
<!-- Pressure Network Toolbar -->
                        <Border Background="White" CornerRadius="5" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Filter:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="NetworkZoneFilterCombo" Width="170" VerticalAlignment="Center" Margin="0,0,12,0"
                                              SelectionChanged="NetworkZoneFilter_Changed"/>
                                    <CheckBox x:Name="NetworkSelectedOnlyCheckbox" Content="Selected room's network only"
                                              VerticalAlignment="Center" Margin="0,0,16,0"
                                              Checked="NetworkSelectedOnly_Changed" Unchecked="NetworkSelectedOnly_Changed"/>
                                    <Separator Width="1" Height="20" Background="#CCC" Margin="0,0,16,0"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#555">
                                        <Run Text="🟢 Positive"/><Run Text="   "/>
                                        <Run Text="🔵 Neutral"/><Run Text="   "/>
                                        <Run Text="🔴 Negative / Fails Requirement"/><Run Text="   "/>
                                        <Run Text="⚠ Cascade issue"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="NetworkZoomInButton"  Content="➕" Width="28" Height="26" Margin="0,0,4,0" Click="NetworkZoomIn_Click" ToolTip="Zoom in"/>
                                    <Button x:Name="NetworkZoomOutButton" Content="➖" Width="28" Height="26" Margin="0,0,4,0" Click="NetworkZoomOut_Click" ToolTip="Zoom out"/>
                                    <Button x:Name="NetworkResetViewButton" Content="⤢ Reset" Width="64" Height="26" Click="NetworkResetView_Click" ToolTip="Reset zoom and pan"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Network Canvas with zoom/pan -->
                        <Border Background="White" BorderBrush="#DDD" BorderThickness="1" ClipToBounds="True">
                            <Grid x:Name="NetworkViewport" Background="#FAFAFA"
                                  MouseWheel="NetworkViewport_MouseWheel"
                                  MouseLeftButtonDown="NetworkViewport_MouseLeftButtonDown"
                                  MouseLeftButtonUp="NetworkViewport_MouseLeftButtonUp"
                                  MouseMove="NetworkViewport_MouseMove"
                                  ClipToBounds="True">
                                <Canvas x:Name="NetworkCanvas" Background="Transparent"
                                        Width="3000" Height="2000"
                                        IsVisibleChanged="NetworkCanvas_IsVisibleChanged">
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="NetworkScaleTransform" ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform x:Name="NetworkTranslateTransform" X="0" Y="0"/>
                                        </TransformGroup>
                                    </Canvas.RenderTransform>
                                    <!-- Edges and nodes are added programmatically in code-behind -->
                                </Canvas>
                                <TextBlock x:Name="NetworkEmptyStateText"
                                           Text="No spaces with door connections found. The Pressure Network shows spaces that are linked by doors in the model."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#999" FontSize="13" TextWrapping="Wrap" MaxWidth="400"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                </Grid>
            </TabItem>
        </TabControl>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="SizeAirflowButton"
                    Content="⚙ Design &amp; Size Terminals"
                    Width="190" Height="30" Margin="0,0,10,0"
                    Background="#1A1A2E" Foreground="White" FontWeight="Bold"
                    Click="SizeAirflow_Click"
                    ToolTip="Calculate required supply and return/exhaust from target ACH and pressure, then write those values to all air terminals in each space."/>
            <Button x:Name="SavePressuresButton" Content="Apply to Model" Width="160" Height="30" Margin="0,0,10,0" Click="SavePressures_Click"/>
            <Button x:Name="ExportButton"        Content="Export to CSV"           Width="110" Height="30" Margin="0,0,10,0" Click="ExportButton_Click"/>
            <Button x:Name="RefreshButton"       Content="Refresh"                 Width="80"  Height="30" Margin="0,0,10,0" Click="RefreshButton_Click"/>
            <Button x:Name="CloseButton"         Content="Close"                   Width="80"  Height="30" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
